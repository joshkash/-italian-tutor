# Rename this file to .env and add your Anthropic API key
# Get your key at: https://console.anthropic.com
# WARNING: For local development only — never commit your .env file or deploy publicly with a key here!
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here


# Optional: "Sign in with GitHub" to sync progress across devices (see README → "Sign-in & sync").
# Set these in Vercel → Settings → Environment Variables. Server-side only — never prefix with VITE_.
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
