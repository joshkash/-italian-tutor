# Rename this file to .env and add your Anthropic API key
# Get your key at: https://console.anthropic.com
# WARNING: For local development only — never commit your .env file or deploy publicly with a key here!
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: sign-in so your progress syncs across devices (see README → "Sign-in & sync")
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
